# Brewfile for the isolated dev account's Homebrew (~/.homebrew).
#
# This file is the SOURCE OF TRUTH for what is installed, not a wishlist:
# `./reapply.sh` reports anything installed here that isn't listed below.
# If you `brew install` something and want to keep it, add it here --
# otherwise the next reapply will tell you it drifted.
#
# NOTE: bash is deliberately NOT declared. The scripts here are bash but
# must run under macOS's stock 3.2 -- bootstrap.sh executes on a fresh
# machine before Homebrew exists, so it can never assume a newer one.
#
# Usage:
#   brew bundle --file=dev/Brewfile    # install everything below
#   ./reapply.sh                       # install + report drift
#   ./reapply.sh --prune               # ...and uninstall what isn't listed

# ---- Taps ----
tap "0xshug0/audio-cpp", "https://github.com/0xShug0/homebrew-audio-cpp", trusted: true

# ---- CLI essentials ----
brew "git"          # likely newer than the system git
brew "gh"           # GitHub CLI
brew "fzf"          # fuzzy finder
brew "ripgrep"      # fast recursive grep
brew "stow"         # dotfiles symlink management
brew "mise"         # per-project language/tool version manager
brew "tree"         # directory tree listing

# ---- Terminal multiplexer ----
brew "tmux"

# ---- Editor ----
brew "neovim"
brew "tree-sitter"      # neovim dependency, kept explicit
brew "tree-sitter-cli"  # :TSInstall grammar compilation

# ---- Language runtimes ----
# Intentionally none. Runtimes are pinned in dev/.config/mise/config.toml
# and installed by mise, which pins an exact version instead of tracking
# whatever a brew formula happens to point at this week. `mise` itself is
# declared above, since something has to bootstrap the bootstrapper.
# (python@3.14 will still appear installed -- it is a dependency of hf.)

# ---- Containers (optional; comment out if unneeded) ----
brew "colima"
brew "docker"
brew "docker-buildx"
brew "docker-compose"

# ---- Model tooling (optional; used by local LLM / pi agent setup) ----
brew "hf"                          # HuggingFace hub client (pulls in python@3.14)
brew "0xshug0/audio-cpp/audio-cpp" # C++ audio inference engine powered by ggml

# ---- Casks (GUI apps / fonts) ----
cask "font-fira-code-nerd-font"
# cask "visual-studio-code"
# cask "obsidian"

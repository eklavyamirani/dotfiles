# Brewfile for the isolated dev account's Homebrew (~/.homebrew).
#
# This file is the SOURCE OF TRUTH for what Homebrew installs, not a
# wishlist: `./reapply.sh` reports anything installed here that isn't
# listed below. If you `brew install` something and want to keep it, add
# it here -- otherwise the next reapply will tell you it drifted.
#
# ---------------------------------------------------------------------
# THE SPLIT: pinned CLI tools live in dev/.config/mise/config.toml.
#
# Homebrew cannot pin a version and cannot roll one back, and in this
# account's non-default prefix it builds most formulae from source. So
# anything mise has a backend for is pinned there, and only these four
# categories stay here:
#
#   1. bootstrap dependencies  -- stow, mise (something has to run first)
#   2. tools with NO mise backend (checked against mise's registry)
#   3. docker CLI *plugins*    -- see the note in the containers section
#   4. casks                   -- mise does not manage .app bundles
#
# Do not re-add a CLI formula here by reflex: check `mise registry` first,
# and if it resolves, pin it in dev/.config/mise/config.toml instead.
# ---------------------------------------------------------------------
#
# NOTE: bash is deliberately NOT declared. The scripts here are bash but
# must run under macOS's stock 3.2 -- bootstrap.sh executes on a fresh
# machine before Homebrew exists, so it can never assume a newer one.
#
# Usage:
#   brew bundle --file=dev/Brewfile    # install everything below
#   ./reapply.sh                       # install + report drift
#   ./reapply.sh --prune               # ...and uninstall what isn't listed

# ---- Taps ----
tap "0xshug0/audio-cpp", "https://github.com/0xShug0/homebrew-audio-cpp", trusted: true

# ---- Bootstrap dependencies ----
# stow links this package into $HOME (so it must exist before the mise
# config does), and mise installs everything in config.toml. mise itself is
# therefore the one tool whose version nothing pins -- documented in README.
brew "stow"
brew "mise"

# ---- No mise backend (still unpinned; that gap is deliberate and visible) ----
brew "git"                         # not in mise's registry (only git-* helpers)
brew "tree"                        # not in mise's registry
brew "hf"                          # HuggingFace hub client (pulls in python@3.14)
brew "0xshug0/audio-cpp/audio-cpp" # C++ audio inference engine powered by ggml

# ---- Containers ----
# The docker *client* is pinned in mise. These two are not tools on PATH but
# docker CLI plugins: `docker buildx` / `docker compose` resolve from
# ~/.docker/cli-plugins, which dev/.local/bin/link-docker-cli-plugins fills
# from this Homebrew prefix. docker-compose does have a mise backend, but
# moving it would leave `docker compose` broken unless that script learned a
# second source directory -- not worth the coupling for one formula.
# docker-buildx has no mise backend at all.
brew "docker-buildx"
brew "docker-compose"

# ---- CLI tools and runtimes ----
# Intentionally none. gh, fzf, ripgrep, tmux, neovim, tree-sitter, colima,
# docker and python are pinned to exact versions in
# dev/.config/mise/config.toml and installed by mise.
# (python@3.14 will still appear installed -- it is a dependency of hf.)

# ---- Casks (GUI apps / fonts) ----
cask "font-fira-code-nerd-font"
# cask "visual-studio-code"
# cask "obsidian"

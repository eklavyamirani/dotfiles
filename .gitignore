# Allowlist model for every packages/*/.config: anything new placed here (e.g. a tool's
# config directory under ~/.config) is untracked by default, since these
# directories commonly grow credential/token files over time (API keys,
# OAuth tokens, session cookies) that would otherwise get silently
# `git add -A`'d the moment they appear. To track a new config, explicitly
# un-ignore it below (both the directory and its contents).
packages/*/.config/*

# nvim config is managed by sync-external-repos, not tracked in this repo
# (already excluded by the wildcard above; listed for clarity)

!packages/macos/.config/terminal/
!packages/macos/.config/terminal/**

# WezTerm config (Lua modules only -- WezTerm keeps no state or credentials
# in this directory).
!packages/unix/.config/wezterm/
!packages/unix/.config/wezterm/**

!packages/unix/.config/llama-server/
!packages/unix/.config/llama-server/**

!packages/common/.config/external-repos.json

# Pinned language runtimes (versions only -- mise keeps installs and any
# credentials elsewhere, under ~/.local/share/mise)
!packages/common/.config/mise/
!packages/common/.config/mise/config.toml

# Nix settings only (Linux). Deliberately narrow: nix.conf is the sole file
# un-ignored here, because ~/.config/nix is also where `nix` writes
# netrc-file paths and access tokens for private flake inputs -- exactly the
# kind of thing this allowlist exists to keep out.
!packages/linux/.config/nix/
!packages/linux/.config/nix/nix.conf

# Herdr keeps its config and its runtime state in the same directory, so the
# allowlist is re-applied one level down: sockets, logs, session.json, the
# .plugins.lock, and the generated plugins.json registry (absolute paths,
# rewritten on every link/enable) all stay machine-local. Only config.toml and
# the locally authored plugin are tracked.
!packages/unix/.config/herdr/
packages/unix/.config/herdr/*
!packages/unix/.config/herdr/config.toml
!packages/unix/.config/herdr/plugins/
packages/unix/.config/herdr/plugins/*
!packages/unix/.config/herdr/plugins/workspace-manager/
!packages/unix/.config/herdr/plugins/workspace-manager/**
packages/unix/.config/herdr/plugins/workspace-manager/__pycache__/
!packages/unix/.config/herdr/plugins/config/
packages/unix/.config/herdr/plugins/config/*
!packages/unix/.config/herdr/plugins/config/local.workspace-manager/
!packages/unix/.config/herdr/plugins/config/local.workspace-manager/keys.toml

# Claude Code writes credentials, session transcripts, todo state, shell
# snapshots, and per-project caches into ~/.claude. Only the managed
# configuration belongs in the repository.
packages/common/.claude/*
!packages/common/.claude/CLAUDE.md
!packages/common/.claude/settings.json
!packages/common/.claude/statusline-command.sh
!packages/common/.claude/skills/
!packages/common/.claude/skills/**

# Pi agent runtime state may contain credentials, downloaded binaries,
# session history, caches, and machine-local UI settings.
packages/common/.pi/agent/*
!packages/common/.pi/agent/models.json
!packages/common/.pi/agent/prompts/
!packages/common/.pi/agent/prompts/**
